# ===== Fila de Senhas — configuração do servidor (copie para .env) =====

# Banco PostgreSQL (produção). Troque usuário/senha/banco conforme database/init_db.sql
DATABASE_URL=postgresql+psycopg://senhas:TROQUE_ESTA_SENHA@localhost:5432/senhas_lab
# Para desenvolvimento/demonstração sem PostgreSQL (NÃO usar em produção):
# DATABASE_URL=sqlite:///data/dev.db

# Endereço/porta do servidor web. 80 = os PCs acessam só http://IP-DO-SERVIDOR
# (no Windows, a porta 80 exige executar como Administrador/serviço; use 8000 para testes)
HOST=0.0.0.0
PORT=80

# Fuso horário do hospital (define "hoje", virada do dia, horários impressos e relatórios)
TIMEZONE=America/Sao_Paulo

# Onde ficam backups e dados internos (pode ser outro disco). Pode ser sobrescrito em Configurações > Backup.
BACKUP_DIR=backups
DATA_DIR=data

# Pasta com pg_dump/pg_restore quando NÃO estão no PATH (Windows). Ex.: C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=

# Senha temporária do primeiro administrador. VAZIO (recomendado) = gerada aleatoriamente e gravada em
# data/PRIMEIRO_ACESSO.txt. Em qualquer caso o sistema EXIGE trocar a senha no primeiro login.
INITIAL_ADMIN_USERNAME=administrador
INITIAL_ADMIN_PASSWORD=
